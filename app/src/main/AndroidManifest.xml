<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No runtime permissions are declared (DESIGN.md D7): zero runtime
      permissions. The only permission below is a NORMAL (install-granted) one,
      exercised only when the user enables a shortener host.
    -->

    <!-- D9: INTERNET is a NORMAL (install-granted) permission, NOT a runtime
         permission. It is only exercised when the user enables a shortener host;
         all built-in hosts are disabled by default, so a default install makes
         zero network calls. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Browser discovery without QUERY_ALL_PACKAGES (DESIGN.md 8). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!--
          Explicit packages we may attach best-effort private extras to
          (DESIGN.md 7). Harmless if not installed; improves package-visibility
          on API 30+ so the vendor extras resolve.
        -->
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkRouter">

        <!-- Normal app icon (distinct from the browser role, DESIGN.md 3/10). -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.LinkRouter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Transparent ACTION_VIEW interceptor (DESIGN.md 2/3).
          Registered as a candidate default browser; the user sets it in
          system settings.
        -->
        <activity
            android:name=".DispatcherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkRouter.Transparent">
            <intent-filter android:label="@string/dispatcher_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          In-app browser chooser (DESIGN.md 9). Internal only (not exported):
          it is launched exclusively by LinkRouter via an explicit component
          intent, never by the framework. It is intentionally NOT registered
          with an ACTION_VIEW intent-filter, so it never appears as a browser
          option in any system chooser.
        -->
        <activity
            android:name=".BrowserChooserActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LinkRouter" />

        <!--
          In-app WebView target (DESIGN.md 7). Internal only (not exported):
          launched exclusively by LinkRouter via an explicit component intent.
          No ACTION_VIEW filter — never appears as a browser in the system chooser.
        -->
        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.LinkRouter" />

        <!--
          Ephemeral resolution WebView (DESIGN.md 6 / M7). Internal only (not
          exported): launched exclusively by LinkRouter (via the dispatcher) to
          settle JS/Cloudflare shortener interstitials and return the final URL.
          It is a *resolution* mechanism, not a browsing experience (no chrome).
          No ACTION_VIEW filter — never appears as a browser in the system chooser.
        -->
        <activity
            android:name=".ResolutionWebViewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LinkRouter" />
    </application>
</manifest>
