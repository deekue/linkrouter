<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions are declared (DESIGN.md D7): zero runtime permissions,
      zero network access.
    -->

    <!-- Browser discovery without QUERY_ALL_PACKAGES (DESIGN.md 8). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkRouter">

        <!-- Normal app icon (distinct from the browser role, DESIGN.md 3/10). -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.LinkRouter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Transparent ACTION_VIEW interceptor (DESIGN.md 2/3).
          Registered as a candidate default browser; the user sets it in
          system settings.
        -->
        <activity
            android:name=".DispatcherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkRouter.Transparent">
            <intent-filter android:label="@string/dispatcher_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          In-app browser chooser (DESIGN.md 9). Internal only (not exported):
          it is launched exclusively by LinkRouter via an explicit component
          intent, never by the framework. It is intentionally NOT registered
          with an ACTION_VIEW intent-filter, so it never appears as a browser
          option in any system chooser.
        -->
        <activity
            android:name=".BrowserChooserActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LinkRouter" />
    </application>
</manifest>
