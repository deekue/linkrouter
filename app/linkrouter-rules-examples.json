          "expectedOutput": "https://example.com/page?utm_campaign=x"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "stkn",
      "host": "instagram.com",
      "examples": [
        {
          "input": "https://www.instagram.com/explore/tags/web/?stkn=992",
          "expectedOutput": "https://www.instagram.com/explore/tags/web/"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    }
  ],
  "shortenerHosts": [
    {
      "name": "Facebook share links",
      "host": "www.facebook.com",
      "pathPrefix": "/share/",
      "enabled": false,
      "isBuiltIn": true,
      "examples": [
        {
          "input": "https://www.facebook.com/share/r/19QBkCyWfA/",
          "expectedOutput": "https://www.facebook.com/reel/1444921104160657/"
        }
      ]
    },
    {
      "name": "TikTok short links",
      "host": "www.tiktok.com",
      "pathPrefix": "/t/",
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "name": "buff.ly",
      "host": "buff.ly",
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "name": "ow.ly",
      "host": "ow.ly",
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "name": "tinyurl.com",
      "host": "tinyurl.com",
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "name": "is.gd",
      "host": "is.gd",
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "name": "bit.ly",
      "host": "bit.ly",
      "enabled": false,
      "isBuiltIn": true,
      "examples" : [
        { "input": "https://bitly.com/98K8eH", "expectedOutput": "https://www.youtube.com/watch?v=dQw4w9WgXcQ" }
