      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "_t",
      "host": "tiktok.com",
      "examples": [
        {
          "input": "https://www.tiktok.com/@tonononotonononon1/video/7590307485039283474?_t=88233&utm_source=copy",
          "expectedOutput": "https://www.tiktok.com/@tonononotonononon1/video/7590307485039283474?utm_source=copy"
