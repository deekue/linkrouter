  "hostRewrites": [
    {
      "matchHost": "nytimes.com",
      "matchType": "EXACT_HOST",
      "kind": "PATH_PREFIX_REWRITE",
      "targetHost": "archive.md",
      "examples": [
        {
          "input": "https://www.nytimes.com/2026/09/16/us/merriam-webster-new-words-looksmaxxing-yacht-rock.html",
          "expectedOutput": "https://archive.md/www.nytimes.com/2026/09/16/us/merriam-webster-new-words-looksmaxxing-yacht-rock.html"
        }
      ],
      "preserveHostInPath": true,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "geocities.com",
      "matchType": "EXACT_HOST",
      "kind": "PATH_PREFIX_REWRITE",
      "targetHost": "web.archive.org/web/*/",
      "examples": [
        {
          "input": "http://geocities.com/SiliconValley/",
          "expectedOutput": "http://web.archive.org/web/*/geocities.com/SiliconValley/"
        }
      ],
      "preserveHostInPath": true,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "www.tiktok.com",
      "matchType": "EXACT_WWW_HOST",
      "kind": "HOST_SWAP",
      "targetHost": "www.seetiktok.com",
      "examples": [
        {
          "input": "https://www.tiktok.com/@pareidoliate/video/7685839018021473566",
          "expectedOutput": "https://www.seetiktok.com/@pareidoliate/video/7685839018021473566"
        }
      ],
      "preserveHostInPath": false,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "twitter.com",
      "matchType": "EXACT_HOST",
      "kind": "HOST_SWAP",
      "targetHost": "flurbx.com",
      "examples": [
        {
          "input": "https://twitter.com/elmo/status/2068016008086872413",
          "expectedOutput": "https://flurbx.com/elmo/status/2068016008086872413"
        }
      ],
      "preserveHostInPath": false,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "x.com",
      "matchType": "EXACT_HOST",
      "kind": "HOST_SWAP",
      "targetHost": "flurbx.com",
      "examples": [
        {
          "input": "https://x.com/elmo/status/2068016008086872413",
          "expectedOutput": "https://flurbx.com/elmo/status/2068016008086872413"
        }
      ],
      "preserveHostInPath": false,
      "enabled": false,
      "isBuiltIn": true
    }
  ]
}
