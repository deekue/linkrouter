  "hostRewrites": [
    {
      "matchHost": "nytimes.com",
      "matchType": "EXACT_HOST",
      "kind": "PATH_PREFIX_REWRITE",
      "targetHost": "archive.md",
      "examples": [
        {
          "input": "https://nytimes.com/2024/04/01/tech/foo.html",
          "expectedOutput": "https://archive.md/nytimes.com/2024/04/01/tech/foo.html"
        }
      ],
      "preserveHostInPath": true,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "geocities.com",
      "matchType": "EXACT_HOST",
      "kind": "PATH_PREFIX_REWRITE",
      "targetHost": "web.archive.org/web/*/",
      "examples": [
        {
          "input": "http://geocities.com/SiliconValley/1234/index.html",
          "expectedOutput": "http://web.archive.org/web/*/geocities.com/SiliconValley/1234/index.html"
        }
      ],
      "preserveHostInPath": true,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "www.tiktok.com",
      "matchType": "EXACT_WWW_HOST",
      "kind": "HOST_SWAP",
      "targetHost": "www.seetiktok.com",
      "examples": [
        {
          "input": "https://www.tiktok.com/@user/video/7123",
          "expectedOutput": "https://www.seetiktok.com/@user/video/7123"
        }
      ],
      "preserveHostInPath": false,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "twitter.com",
      "matchType": "EXACT_HOST",
      "kind": "HOST_SWAP",
      "targetHost": "xcancel.com",
      "examples": [
        {
          "input": "https://twitter.com/enigma/status/1234",
          "expectedOutput": "https://xcancel.com/enigma/status/1234"
        }
      ],
      "preserveHostInPath": false,
      "enabled": false,
      "isBuiltIn": true
    },
    {
      "matchHost": "x.com",
      "matchType": "EXACT_HOST",
      "kind": "HOST_SWAP",
      "targetHost": "xcancel.com",
      "examples": [
        {
          "input": "https://x.com/enigma/status/1234",
          "expectedOutput": "https://xcancel.com/enigma/status/1234"
        }
      ],
      "preserveHostInPath": false,
      "enabled": false,
      "isBuiltIn": true
    }
  ]
}
