{
  "version": 1,
  "rules": [],
  "redirectFormats": [
    {
      "name": "Google www",
      "pattern": "www.google.com/url",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "q",
      "enabled": true,
      "priority": 1001,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Google",
      "pattern": "google.com/url",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "q",
      "enabled": true,
      "priority": 1000,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Facebook (redirect.php)",
      "pattern": "facebook.com/redirect.php",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "u",
      "enabled": true,
      "priority": 4,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Facebook (l.php)",
      "pattern": "l.facebook.com/l.php",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "u",
      "enabled": true,
      "priority": 3,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Mailchimp/Mandrill",
      "pattern": "*.email.mandrillapp.com",
      "matchType": "SUBDOMAIN",
      "extractType": "QUERY_PARAM",
      "extractTarget": "lc",
      "enabled": true,
      "priority": 2,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Reddit (in-site)",
      "pattern": "reddit.com/redirect/",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "url",
      "enabled": true,
      "priority": 1,
      "isBuiltIn": true,
      "openRealDestination": true
    }
  ],
  "queryParamFilters": [
    {
      "param": "original_uri",
      "host": "facebook.com",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "feature",
      "host": "youtube.com",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "si",
      "host": "youtube.com",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "igshid",
      "host": "instagram.com",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "igsi",
      "host": "instagram.com",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "_t",
      "host": "tiktok.com",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "mc_cid",
      "enabled": false,
      "builtIn": true
    },
    {
      "param": "mc_eid",
      "enabled": false,
      "builtIn": true
