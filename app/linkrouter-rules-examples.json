      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "_t",
      "host": "tiktok.com",
      "examples": [
        {
          "input": "https://www.tiktok.com/@user/video/7123?_t=88233&utm_source=copy",
          "expectedOutput": "https://www.tiktok.com/@user/video/7123?utm_source=copy"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "mc_cid",
