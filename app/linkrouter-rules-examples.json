          "input": "https://example.com/pricing?mc_eid=e2&utm_source=dl",
          "expectedOutput": "https://example.com/pricing?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "sharer_id",
      "examples": [
        {
          "input": "https://example.com/page?sharer_id=42&utm_source=share",
          "expectedOutput": "https://example.com/page?utm_source=share"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "fbid",
      "examples": [
        {
          "input": "https://example.com/page?fbid=abc&utm_source=share",
          "expectedOutput": "https://example.com/page?utm_source=share"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "fbclid",
      "examples": [
        {
          "input": "https://example.com/page?fbclid=xyz&utm_source=share",
          "expectedOutput": "https://example.com/page?utm_source=share"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "msclkid",
      "examples": [
        {
          "input": "https://example.com/page?msclkid=abc&utm_source=share",
          "expectedOutput": "https://example.com/page?utm_source=share"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "gclsrc",
      "examples": [
        {
          "input": "https://example.com/page?gclsrc=aw&utm_source=dl",
          "expectedOutput": "https://example.com/page?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "gclid",
      "examples": [
        {
          "input": "https://example.com/page?gclid=abc&utm_source=dl",
          "expectedOutput": "https://example.com/page?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "utm_content",
      "examples": [
        {
          "input": "https://example.com/page?utm_content=abc&utm_source=dl",
          "expectedOutput": "https://example.com/page?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "utm_term",
      "examples": [
        {
          "input": "https://example.com/page?utm_term=abc&utm_source=dl",
          "expectedOutput": "https://example.com/page?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "utm_campaign",
      "examples": [
        {
          "input": "https://example.com/page?utm_campaign=abc&utm_source=dl",
          "expectedOutput": "https://example.com/page?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "utm_medium",
      "examples": [
        {
          "input": "https://example.com/page?utm_medium=abc&utm_source=dl",
          "expectedOutput": "https://example.com/page?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "utm_source",
      "examples": [
        {
          "input": "https://example.com/page?utm_source=dl&utm_campaign=x",
          "expectedOutput": "https://example.com/page?utm_campaign=x"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "stkn",
      "host": "instagram.com",
      "examples": [
        {
          "input": "https://www.instagram.com/explore/tags/web/?stkn=992",
          "expectedOutput": "https://www.instagram.com/explore/tags/web/"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    }
  ],
  "shortenerHosts": [
    {
      "name": "Facebook share links",
      "host": "www.facebook.com",
