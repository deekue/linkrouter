        {
          "input": "https://example.com/pricing?mc_cid=d1&utm_source=dl",
          "expectedOutput": "https://example.com/pricing?utm_source=dl"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "mc_eid",
      "examples": [
