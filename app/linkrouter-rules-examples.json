{
  "version": 1,
  "rules": [],
  "redirectFormats": [
    {
      "name": "Google www",
      "examples": [
        { "input": "https://www.google.com/url?q=https%3A%2F%2Fexample.com%2Fpage", "expectedOutput": "https://example.com/page" }
      ],
      "pattern": "www.google.com/url",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "q",
      "enabled": true,
      "priority": 1001,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Google",
      "examples": [
        { "input": "https://google.com/url?q=https%3A%2F%2Fexample.com%2Fx", "expectedOutput": "https://example.com/x" }
      ],
      "pattern": "google.com/url",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "q",
      "enabled": true,
      "priority": 1000,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Facebook (redirect.php)",
      "examples": [
        { "input": "https://www.facebook.com/redirect.php?u=https%3A%2F%2Fexample.com", "expectedOutput": "https://example.com" }
      ],
      "pattern": "facebook.com/redirect.php",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "u",
      "enabled": true,
      "priority": 4,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Facebook (l.php)",
      "examples": [
        { "input": "https://l.facebook.com/l.php?u=https%3A%2F%2Fexample.com", "expectedOutput": "https://example.com" }
      ],
      "pattern": "l.facebook.com/l.php",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "u",
      "enabled": true,
      "priority": 3,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Mailchimp/Mandrill",
      "examples": [
        { "input": "https://abc5.email.mandrillapp.com/?lc=https%3A%2F%2Fexample.com", "expectedOutput": "https://example.com" }
      ],
      "pattern": "*.email.mandrillapp.com",
      "matchType": "SUBDOMAIN",
      "extractType": "QUERY_PARAM",
      "extractTarget": "lc",
      "enabled": true,
      "priority": 2,
      "isBuiltIn": true,
      "openRealDestination": true
    },
    {
      "name": "Reddit (in-site)",
      "examples": [
        { "input": "https://www.reddit.com/redirect/abc?url=https%3A%2F%2Fexample.com", "expectedOutput": "https://example.com" }
      ],
      "pattern": "reddit.com/redirect/",
      "matchType": "PATH_PREFIX",
      "extractType": "QUERY_PARAM",
      "extractTarget": "url",
      "enabled": true,
      "priority": 1,
      "isBuiltIn": true,
      "openRealDestination": true
    }
  ],
  "queryParamFilters": [
    {
      "param": "original_uri",
      "host": "facebook.com",
      "examples": [
        {
          "input": "https://www.facebook.com/share/r/xyz/?original_uri=https%3A%2F%2Fenigma.com%2Fp&utm_source=native",
          "expectedOutput": "https://www.facebook.com/share/r/xyz/?utm_source=native"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "feature",
      "host": "youtube.com",
      "examples": [
        {
          "input": "https://www.youtube.com/watch?v=AbCd12&feature=share",
          "expectedOutput": "https://www.youtube.com/watch?v=AbCd12"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "si",
      "host": "youtube.com",
      "examples": [
        {
          "input": "https://www.youtube.com/watch?v=AbCd12&si=Zz9",
          "expectedOutput": "https://www.youtube.com/watch?v=AbCd12"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "igshid",
      "host": "instagram.com",
      "examples": [
        {
          "input": "https://www.instagram.com/reel/Cx1/?igshid=1a2b3c&utm_source=ig_web",
          "expectedOutput": "https://www.instagram.com/reel/Cx1/?utm_source=ig_web"
        }
      ],
      "enabled": true,
      "isBuiltIn": true
    },
    {
      "param": "igsi",
      "host": "instagram.com",
