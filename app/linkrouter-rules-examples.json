    {
      "name": "Google",
      "host": "share.google",
      "enabled": false,
      "isBuiltIn": true,
      "examples" : [
        { "input": "https://share.google/KkoDIfmzpmsc1W2AX", "expectedOutput": "https://www.youtube.com/shorts/IHVDpLvbiUw" }
      ]
    }
