  "shortenerHosts": [
    {
      "name": "Facebook share links",
      "host": "www.facebook.com",
      "pathPrefix": "/share/r/",
      "enabled": false,
      "builtIn": true
    },
    {
      "name": "TikTok short links",
      "host": "www.tiktok.com",
      "pathPrefix": "/t/",
      "enabled": false,
      "builtIn": true
    },
    {
      "name": "buff.ly",
      "host": "buff.ly",
      "enabled": false,
      "builtIn": true
    },
    {
      "name": "ow.ly",
      "host": "ow.ly",
